// ─────────────────────────────────────────────────────────────
// MCP 서버 정의
//
// 값 안의 ${VAR} 는 프로세스 환경변수로 치환됩니다.
// → 토큰을 이 파일에 하드코딩하지 말고 .env 에 두세요.
//
//   "type": "stdio"  컨테이너 안에서 프로세스를 띄웁니다.
//   "type": "http"   원격 MCP 서버(Streamable HTTP)에 붙습니다.
//
// 여기에 정의만 해두고, 각 앱의 mcpServers 에 이름을 적어야 실제로 노출됩니다.
// 툴 이름은 `<서버이름>__<툴이름>` 으로 네임스페이싱되어 서버 간 충돌이 없습니다.
// ─────────────────────────────────────────────────────────────
{
  "mcpServers": {
    "internal-docs": {
      "type": "http",
      "url": "https://mcp.internal.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${INTERNAL_MCP_TOKEN}"
      },
      "disabled": true
    },

    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/data"],
      "env": {},
      "disabled": true
    }
  }
}
