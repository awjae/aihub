# ─────────────────────────────────────────────────────────────
# AI Hub — 환경변수
# 실제 배포 시 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# ── 서버 ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# 앱(폼) 정의 파일 / MCP 서버 정의 파일 경로
APPS_CONFIG_PATH=./config/apps.json
MCP_CONFIG_PATH=./config/mcp.json

# 사내망 전용이라 인증은 없음. 프론트가 다른 오리진이면 여기에 명시.
CORS_ORIGIN=*

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
# 사내 vLLM / Ollama / LiteLLM 등 OpenAI 호환 엔드포인트도 여기에 지정 가능
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 실행 제한 ─────────────────────────────────────────────────
# 모델 → 툴 실행 → 모델 재호출 루프의 최대 반복 횟수
MAX_TOOL_ITERATIONS=8
# 툴 1회 호출 타임아웃 (ms)
MCP_TOOL_TIMEOUT_MS=60000
# 툴 결과가 이 길이를 넘으면 잘라서 모델에 전달
MAX_TOOL_RESULT_CHARS=20000

# ── Client VPN (VPC 밖에 띄울 때만) ────────────────────────────
# VPC 내부 자원(운영 DB 등)을 쓰는 앱이 있고 게이트웨이가 VPC 밖에 있으면
# 필요합니다. 아래가 비어 있거나 파일이 없으면 VPN 기능 전체가 꺼지고 화면에도
# 안 뜹니다. (VPC 안에 배포하면 그대로 두세요)
#
# 서브넷 연결(과금 대상)은 개발자가 akita 저장소에서 직접 켜고 끕니다:
#   ./scripts/client-vpn.sh production on   (다 쓰면 off)
# 이 컨테이너는 그 상태를 따라가기만 하므로 AWS 자격증명이 필요 없습니다.
#
# akita 저장소에서 `make prod-ovpn` 으로 만든 뒤 config/ 에 두세요.
# VPN_OVPN_CONFIG=/app/config/production.ovpn

# 도달 확인 대상(host:port). 비우면 DATABASE_URL 에서 뽑습니다.
# VPN_PROBE_TARGET=

# ── MCP 서버용 시크릿 (mcp.json 에서 ${VAR} 로 참조) ──────────
# INTERNAL_MCP_TOKEN=
