# ─────────────────────────────────────────────────────────────
# AI Hub — 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
# 값이 비어 있는 항목만 채우면 됩니다. 주석 처리된 항목은 기본값이 있어
# 건드릴 필요가 없고, 기본값을 바꿔야 할 때만 주석을 풀어 쓰세요.
#
# ── 파일이 둘인 이유 ──────────────────────────────────────────
#   .env          로컬 실행용. cwd 가 server/ 라 경로가 ../config/... 다.
#   .env.deploy   도커 실행용. 생성물이며 compose 가 이걸 읽는다.
#
#     npm run env:deploy      .env → .env.deploy 생성 (경로만 변환)
#     npm run env:check       둘이 어긋났는지 확인
#
#   시크릿의 원본은 .env 하나뿐입니다. 두 벌로 관리하면 키를 갱신할 때
#   한쪽만 바뀌어 조용히 어긋나기 때문입니다.
#
# ── 로컬 실행 시 주의 ─────────────────────────────────────────
#   서버는 .env 를 스스로 읽지 않습니다 (dotenv 미사용). 셸에 먼저 올리세요:
#     cd server && set -a && . ../.env && set +a && npm run start:dev
# ─────────────────────────────────────────────────────────────

# ── 서버 ──────────────────────────────────────────────────────
PORT=3000

# 컨테이너에서는 Dockerfile 이 production 으로 고정합니다.
# 로컬에서 server/ 를 직접 띄울 때만 의미가 있습니다.
# NODE_ENV=production

# 앱(폼) 정의 파일. 컨테이너에서는 docker-compose 가 /app/config/apps.json 으로
# 덮어쓰므로(설정 디렉터리를 마운트하기 때문) 로컬 실행에서만 쓰입니다.
APPS_CONFIG_PATH=./config/apps.json

# 사내망 전용이라 인증은 없음. 프론트가 다른 오리진이면 여기에 명시.
CORS_ORIGIN=*

# ── OpenAI ────────────────────────────────────────────────────
# 모델 앱(진단 예측 등)과 질의 생성기(질문 → SQL)가 함께 씁니다.
OPENAI_API_KEY=

# 사내 vLLM / Ollama / LiteLLM 등 OpenAI 호환 엔드포인트도 여기에 지정 가능.
# 모델별로 다른 엔드포인트·키를 쓰려면 config/apps.json 의 models 에서
# baseURL·apiKeyEnv 로 지정하세요 — 그쪽이 이 기본값보다 우선합니다.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 원내 데이터 질의 (mode: "query") ──────────────────────────
# "원내 데이터 질의 AI" 앱이 쓰는 질의 생성기(질문 → SQL). 소스는 별도
# 저장소(akita_schema)에 있지만 같은 이미지에 함께 구워지고, 게이트웨이가
# 질의마다 자식 프로세스로 띄웁니다.
#
# 아래 WORKSPACE_ID / LLM_MODEL / AKITA_* 는 게이트웨이가 아니라 그 자식
# 프로세스가 읽습니다. 게이트웨이는 자기 환경을 그대로 물려주기만 합니다.

# 조회 대상 병원. 생성되는 모든 쿼리에 workspace = $1 로 바인딩됩니다.
WORKSPACE_ID=

# 질문 → QueryPlan 변환에 쓰는 모델. 위의 OPENAI_API_KEY 를 같이 씁니다.
LLM_MODEL=gpt-5-mini

# node/edge 테이블이 있는 스키마. 비우면 repository.
# AKITA_PG_SCHEMA=repository

# 질의 생성기가 읽는 스키마 정의 디렉터리. 비우면 akita_schema 에 동봉된
# docs/ai-schema 를 씁니다 — 보통 그대로 두면 됩니다.
# AKITA_SCHEMA_DIR=

# 질의 생성기 진입 파일. 컨테이너에서는 Dockerfile 이 잡아두므로 건드릴
# 필요 없고, 로컬에서 server/ 를 직접 띄울 때만 필요합니다 (cwd 는 server/).
# AKITA_QUERY_CLI=../../akita_schema/src/ai/cli/query-cli.ts

# ── 원내 DB ───────────────────────────────────────────────────
# SQL 을 실제로 실행하는 것은 게이트웨이입니다. 질의 생성기는 DB 에 붙지
# 않으므로, 아래 값들은 게이트웨이 쪽에서만 쓰입니다.
#
# 읽기 전용 계정을 쓰세요 — 커넥션 풀이 default_transaction_read_only=on 을
# 걸고 단일 SELECT 만 통과시키지만, 계정 권한으로 한 겹 더 막는 편이 안전합니다.
#
# ⚠️ 운영 DB 는 VPC 내부 RDS 입니다. Client VPN 이 연결돼 있어야 조회가 됩니다.
#    akita 저장소에서: ./scripts/client-vpn.sh production on   (쓰고 나면 off — 과금)
DATABASE_URL=

# 쿼리 1회 타임아웃 (ms).
DATABASE_QUERY_TIMEOUT_MS=15000

# DB 연결 타임아웃 (ms). VPN 이 내려갔을 때 매달리지 않도록 짧게 잡습니다.
DATABASE_CONNECT_TIMEOUT_MS=5000

# 한 번에 화면에 돌려줄 최대 행 수.
MAX_ROWS=50

# ── Client VPN (VPC 밖에 띄울 때만) ────────────────────────────
# 운영 DB 는 VPC 내부라, 게이트웨이를 VPC 밖에서 띄우면 VPN 이 필요합니다.
# 아래가 비어 있거나 파일이 없으면 VPN 기능 전체가 꺼지고 화면에도 안 뜹니다.
# (VPC 안에 배포하면 그대로 두세요)
#
# 서브넷 연결(과금 대상)은 개발자가 akita 저장소에서 직접 켜고 끕니다:
#   ./scripts/client-vpn.sh production on   (다 쓰면 off)
# 이 컨테이너는 그 상태를 따라가기만 하므로 AWS 자격증명이 필요 없습니다.
#
# akita 저장소에서 `make prod-ovpn` 으로 만든 뒤 config/ 에 두세요.
# 컨테이너에서는 config/ 가 통째로 마운트되므로 /app/config/... 경로로 적습니다.
# VPN_OVPN_CONFIG=/app/config/production.ovpn

# 도달 확인 대상(host:port). 비우면 DATABASE_URL 에서 뽑습니다.
# VPN_PROBE_TARGET=
